# Copy to deploy/.env for local runs. In Dokploy, paste these into the compose app's Environment tab.
# Never commit real values.

# Observer key that observers type into the client. Letters and digits only.
AUTH_KEY=

# Enable the supporter features (watermark toggle, custom watermark text, multiple round-win
# sponsors, no forced Spectra logo). Allowed by ValoSpectra for self-hosting (#20). Defaults to true.
# TRAYB_SUPPORTER=true

# Dokploy: dokploy-network. Locally: docker network create trayboverlay-dev
PLATFORM_NETWORK=dokploy-network

# Image tag from .github/workflows/images.yml: main (latest) or sha-<7 chars> to pin or roll back
IMAGE_TAG=main

# Where the overlay page connects (defaults shown)
# OVERLAY_SERVER_ENDPOINT=https://data.trayb.az
# OVERLAY_EXTRAS_ENDPOINT=https://extras.trayb.az
# OVERLAY_REDIRECT_URL=https://trayb.az

# Memory caps (shared host) and replay retention (defaults shown)
# SERVER_MEM_LIMIT=512m
# FRONTEND_MEM_LIMIT=64m
# REPLAY_RETENTION_DAYS=14
