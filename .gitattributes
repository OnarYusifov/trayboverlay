# Our own files and every shell script use LF: they run in Linux containers and CI.
# Upstream files keep whatever upstream committed, so syncs don't fight over line endings.
*.sh text eol=lf
/scripts/** text eol=lf
/deploy/** text eol=lf
/docs/** text eol=lf
# Binary assets under docs keep their exact bytes; the text rule above would corrupt them.
/docs/**/*.png binary
/docs/**/*.jpg binary
/docs/**/*.jpeg binary
/docs/**/*.webp binary
/docs/**/*.gif binary
/.github/** text eol=lf
/upstream.lock.json text eol=lf
